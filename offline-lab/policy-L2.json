{
  "_comment": "Same expectations as policy-L1.json, but the consumer now demands authenticated provenance (Build L2+).",
  "min_level": 2,
  "roots_of_trust": [
    {
      "builder_id": "https://ci.orgx.example/runners/hosted",
      "public_key": "keys/platform.pub",
      "max_level": 2
    }
  ],
  "expectations": {
    "buildType": "https://orgx.example/buildtypes/python-wheel/v1",
    "source_repository": "git+https://git.orgx.example/orgx/parcel",
    "allowed_refs": ["refs/heads/main", "refs/tags/v*"],
    "workflow": ".ci/release.yml",
    "externalParameters_allowed_keys": ["repository", "ref", "workflow"]
  }
}
